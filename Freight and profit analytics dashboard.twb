    <worksheet name='Late shipments (%)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Cleaned_Pharma_Data.csv' name='federated.1c04gni0sy6zai14q5ttn0gx7itw' />
          </datasources>
          <datasource-dependencies datasource='federated.1c04gni0sy6zai14q5ttn0gx7itw'>
            <column caption='% Late Shipments' datatype='real' name='[Calculation_1515448832921600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [delivery_delay] &gt; 0 THEN [shipment_id] END) / COUNT([shipment_id])' />
            </column>
            <column caption='Full Month Name' datatype='string' name='[Calculation_1515449215987715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [clean_delivered_date])' />
            </column>
