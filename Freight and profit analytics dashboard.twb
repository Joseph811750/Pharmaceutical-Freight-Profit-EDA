      <aliases enabled='yes' />
      <column caption='% Late Shipments' datatype='real' name='[Calculation_1515448832921600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [delivery_delay] &gt; 0 THEN [shipment_id] END) / COUNT([shipment_id])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_1515448845271041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_profit]) / SUM([revenue])' />
      </column>
